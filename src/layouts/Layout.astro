---
import { buildJsonLd, siteUrl } from "@/lib/seo";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogDescription?: string;
  twitterDescription?: string;
}

const title = "Noureddine Laktab | Full-Stack Web Developer – React & Laravel";
const description =
  "I'm Noureddine Laktab, a Full-Stack Web Developer from Morocco specializing in React and Laravel. I build clean, scalable, and performance-focused web applications. View my portfolio and projects.";

const {
  title: pageTitle = title,
  description: pageDescription = description,
  canonical = siteUrl,
  ogDescription = "Full-Stack Web Developer from Morocco specializing in React & Laravel. Building clean, scalable web applications. View my portfolio, projects, and skills.",
  twitterDescription = "Full-Stack Web Developer from Morocco specializing in React & Laravel. Building clean, scalable web applications.",
} = Astro.props;

const keywords = [
  "Noureddine Laktab",
  "Full Stack Developer",
  "React Developer",
  "Laravel Developer",
  "Web Developer Morocco",
  "PHP Developer",
  "JavaScript Developer",
  "Frontend Developer",
  "Backend Developer",
  "Casablanca Developer",
].join(", ");

const ogImage = `${siteUrl}/profile-og.png`;
const ogAlt = "Noureddine Laktab - Full-Stack Web Developer";
const jsonLd = JSON.stringify(buildJsonLd());

// Runs before first paint so the stored theme is applied without a flash of
// the wrong colours. Mirrors the `theme` key written by <AnimatedThemeToggler />.
const themeScript = `(function(){try{var t=localStorage.getItem("theme");if(!t){t=window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";}document.documentElement.classList.toggle("dark",t==="dark");}catch(e){}})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Noureddine Laktab" />
    <meta name="creator" content="Noureddine Laktab" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content="Noureddine Laktab Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline set:html={themeScript} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
    <script>
      import { inject } from "@vercel/analytics";
      import { injectSpeedInsights } from "@vercel/speed-insights";
      inject();
      injectSpeedInsights();
    </script>
  </body>
</html>
